# ============================================================================
# VaultMedics Environment Variables
# ============================================================================

# ============================================================================
# Supabase Configuration
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Redirect URL for Supabase Auth (auto-set in v0)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Supabase Storage Bucket Name
SUPABASE_STORAGE_BUCKET=medical-records

# ============================================================================
# Gemini AI Configuration
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Get API key from: https://aistudio.google.com/app/apikeys

# ============================================================================
# Blockchain Configuration (Flare)
# ============================================================================

# Private Key for Contract Deployment (Hardhat)
# WARNING: Never commit this to git
# PRIVATE_KEY=your_wallet_private_key_here

# RPC URLs for different Flare networks
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
SONGBIRD_RPC_URL=https://songbird-api.flare.network/ext/C/rpc
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Smart Contract Addresses (populate after deployment)
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REGISTRY_NETWORK=coston2

# ============================================================================
# WalletConnect Configuration (for wagmi)
# ============================================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wallet_connect_id_here

# Get from: https://cloud.walletconnect.com/

# ============================================================================
# Optional: Pinata/IPFS configuration
# ============================================================================
# Use either PINATA_JWT or the legacy API key/secret combo
PINATA_JWT=your_pinata_jwt_here
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# Optional: Encrypt files before pinning to IPFS
# - Use a 32-byte key encoded as hex or base64
IPFS_ENCRYPTION_KEY=your_32_byte_key_here

# ============================================================================
# Optional: Vercel Blob Storage (for encrypted file uploads)
# ============================================================================
# BLOB_READ_WRITE_TOKEN=your_blob_token_here

# ============================================================================
# Development
# ============================================================================
NODE_ENV=development

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Setup Instructions:
# ============================================================================
# 1. Copy this file to .env.local
# 2. Fill in all required values (marked above)
# 3. Never commit .env.local to git
# 
# Supabase:
#   - Create project at https://supabase.com
#   - Get keys from Project Settings > API
#
# Gemini API:
#   - Get free key at https://aistudio.google.com/app/apikeys
#   - No credit card required for basic usage
#
# Blockchain:
#   - Use Coston2 testnet for hackathon
#   - Get free CFLR tokens: https://faucet.flare.network/
#   - Deploy contract with: npx hardhat run scripts/deploy.ts --network coston2
#
# WalletConnect:
#   - Create project at https://cloud.walletconnect.com/
#   - Optional but recommended for mobile wallet support
